# I fill these paths locally and never commit the filled-in copy.
# The v5 figure reads only AMEIVA_DEVELOPMENT_DIR and AMEIVA_PROJECT_DIR.
export AMEIVA_DEVELOPMENT_DIR="/path/to/validated/candidate_directionality_inputs"
export AMEIVA_PROJECT_DIR="/path/to/Ameiva_project"

# The original v4 analytical script also reads these two paths.
export AMEIVA_RESULTS_DIR="/path/to/validated/RDA-2027-14134_results"
export AMEIVA_ENV_FILE="/path/to/Ameiva_Variables_rda.csv"
